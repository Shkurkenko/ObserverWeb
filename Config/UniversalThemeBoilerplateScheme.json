{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Theme Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "properties": {
        "light": {
          "$ref": "#/definitions/colorPalette"
        },
        "dark": {
          "$ref": "#/definitions/colorPalette"
        }
      },
      "required": ["light", "dark"]
    },
    "spacing": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "number",
          "minimum": 1
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        }
      },
      "required": ["unit", "scale"]
    },
    "typography": {
      "type": "object",
      "properties": {
        "fontFamily": {
          "$ref": "#/definitions/fontFamily"
        },
        "fontSize": {
          "$ref": "#/definitions/fontSize"
        },
        "fontWeight": {
          "$ref": "#/definitions/fontWeight"
        },
        "lineHeight": {
          "$ref": "#/definitions/lineHeight"
        }
      },
      "required": ["fontFamily", "fontSize", "fontWeight", "lineHeight"]
    },
    "shape": {
      "type": "object",
      "properties": {
        "borderRadius": {
          "$ref": "#/definitions/borderRadius"
        },
        "borderWidth": {
          "$ref": "#/definitions/borderWidth"
        }
      }
    },
    "elevation": {
      "type": "object",
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "shadow": {
          "$ref": "#/definitions/shadow"
        }
      }
    }
  },
  "required": ["name", "colors", "spacing"],
  "definitions": {
    "colorPalette": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string"
        },
        "onPrimary": {
          "type": "string"
        },
        "primaryContainer": {
          "type": "string"
        },
        "onPrimaryContainer": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "onSecondary": {
          "type": "string"
        },
        "secondaryContainer": {
          "type": "string"
        },
        "onSecondaryContainer": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "onBackground": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "onSurface": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "onError": {
          "type": "string"
        },
        "errorContainer": {
          "type": "string"
        },
        "onErrorContainer": {
          "type": "string"
        },
        "outline": {
          "type": "string"
        },
        "outlineVariant": {
          "type": "string"
        }
      },
      "required": [
        "primary",
        "onPrimary",
        "background",
        "onBackground",
        "surface",
        "onSurface",
        "error",
        "onError"
      ]
    },
    "fontFamily": {
      "type": "object",
      "properties": {
        "sans": {
          "type": "string"
        },
        "mono": {
          "type": "string"
        }
      }
    },
    "fontSize": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "fontWeight": {
      "type": "object",
      "properties": {
        "light": {
          "type": "number"
        },
        "normal": {
          "type": "number"
        },
        "medium": {
          "type": "number"
        },
        "semibold": {
          "type": "number"
        },
        "bold": {
          "type": "number"
        }
      }
    },
    "lineHeight": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "borderRadius": {
      "type": "object",
      "properties": {
        "none": {
          "type": "number"
        },
        "sm": {
          "type": "number"
        },
        "md": {
          "type": "number"
        },
        "lg": {
          "type": "number"
        },
        "xl": {
          "type": "number"
        },
        "2xl": {
          "type": "number"
        },
        "full": {
          "type": "number"
        }
      }
    },
    "borderWidth": {
      "type": "object",
      "properties": {
        "none": {
          "type": "number"
        },
        "thin": {
          "type": "number"
        },
        "medium": {
          "type": "number"
        },
        "thick": {
          "type": "number"
        }
      }
    },
    "shadow": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blur": {
          "type": "number",
          "minimum": 0
        },
        "offsetY": {
          "type": "number"
        }
      }
    }
  }
}
