    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tauri-plugin-device-info-api": "^1.0.1",
    "uuid": "^13.0.0",
    "wouter": "^2.12.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
