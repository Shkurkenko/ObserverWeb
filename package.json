{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:reconfigure": "npm run generate:themes && npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "generate:themes": "npm run generate:process-python-theme && npm run register:themes && npm run generate:themes-tailwind-config && npm run generate:themes-tailwind-css",
    "register:themes": "tsx ./Scripts/RegisterThemes.ts",
    "generate:themes-tailwind-config": "tsx ./Scripts/GenerateTailwindTheme.ts",
    "generate:themes-tailwind-css": "tsx ./Scripts/GenerateTailwindThemeCss.ts",
    "generate:process-python-theme": "python3 ./Config/Themes/ForensicThemes/Scripts/buildTheme.py"
  },
  "dependencies": {
    "preact": "^10.26.9",
    "preact-iso": "^2.11.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "postcss": "^8.5.6",
    "@tailwindcss/postcss": "^4.1.17",
    "@preact/preset-vite": "^2.10.2",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-preact": "^2.0.0",
    "postcss-load-config": "^6.0.1",
    "sass-embedded": "^1.93.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.4"
  },
  "eslintConfig": {
    "extends": "preact"
  }
}